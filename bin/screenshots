#!/usr/bin/env sh
# Remakes the README's screenshots, docs/omaread-light.png and
# docs/omaread-dark.png, from the made-up project in tools/demo/stargazer.
# It is read from a stand-in home folder, so the footer shows
# ~/projects/stargazer/README.md and nothing of this machine.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/projects"
cp -r "$ROOT/tools/demo/stargazer" "$tmp/projects/"

# The light one shows the contents beside the page.
"$ROOT/bin/snapshot" --home "$tmp" --light --outline \
  "$tmp/projects/stargazer/README.md" "$ROOT/docs/omaread-light.png"
"$ROOT/bin/snapshot" --home "$tmp" --dark \
  "$tmp/projects/stargazer/README.md" "$ROOT/docs/omaread-dark.png"
