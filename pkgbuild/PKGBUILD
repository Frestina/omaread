# Maintainer: Frestina

pkgname=omaread
pkgver=0.2.0
pkgrel=1
pkgdesc='Read Markdown files the way GitHub shows them, built with Qt Quick'
arch=('x86_64' 'aarch64')
url='https://github.com/Frestina/omaread'
license=('MIT')
install='omaread.install'
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'cmark-gfm' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omaread "$pkgdir/usr/bin/omaread"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 "$startdir/omaread.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaread.svg"
  /usr/bin/install -Dm644 "$startdir/omaread.desktop" "$pkgdir/usr/share/applications/omaread.desktop"
}
