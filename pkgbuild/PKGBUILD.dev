# Builds the working tree, for ./bin/install; the release recipe is PKGBUILD.
# Maintainer: Frestina

pkgname=omaread
pkgver=$(sed -n 's/^VERSION *= *//p' "$startdir/../omaread.pro")
pkgrel=1
pkgdesc='Read Markdown files the way GitHub shows them, built with Qt Quick'
arch=('x86_64' 'aarch64')
url='https://github.com/Frestina/omaread'
license=('MIT')
options=('!debug')
depends=('cmark-gfm' 'hicolor-icon-theme' 'qt6-base' 'qt6-declarative' 'qt6-svg' 'syntax-highlighting'
         'xdg-desktop-portal')
optdepends=('mathjax: draw math'
            'nodejs: draw math, with mathjax'
            'mermaid-cli: draw Mermaid diagrams')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omaread "$pkgdir/usr/bin/omaread"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/omaread.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaread.svg"
  install -Dm644 pkgbuild/omaread.desktop "$pkgdir/usr/share/applications/omaread.desktop"
}
