#!/usr/bin/env python3
# Remakes src/emojidata.inc, the shortcodes Omaread turns into emoji, from
# GitHub's own list in gemoji (https://github.com/github/gemoji), MIT:
#
#   tools/update-emoji path/to/gemoji/db/emoji.json
#
# Each line is {"shortcode", "emoji"}, sorted, so a lookup can halve its way in.
import json
import pathlib
import sys

if len(sys.argv) != 2:
    sys.exit("usage: tools/update-emoji path/to/emoji.json")

entries = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
codes = {}
for entry in entries:
    # GitHub's own pictures, :octocat: and the like, have no emoji to show.
    if "emoji" not in entry:
        continue
    for alias in entry["aliases"]:
        codes[alias] = entry["emoji"]

out = pathlib.Path(__file__).resolve().parent.parent / "src" / "emojidata.inc"
with out.open("w", encoding="utf-8") as file:
    file.write("// Made by tools/update-emoji from gemoji's db/emoji.json. Do not edit.\n")
    for code in sorted(codes):
        file.write('{"%s", "%s"},\n' % (code, codes[code]))
print(f"{len(codes)} shortcodes written to {out}")
